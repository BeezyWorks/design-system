{
  // Typechecks the design system on its own — no path aliases, no app code.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "noImplicitAny": false,
    "strict": true,
    "noEmit": true,
    "types": ["jest"],
    "baseUrl": null,
    "paths": {}
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["node_modules", "storybook-static"]
}
